# Build output
dist/
*.tsbuildinfo

# Dependencies
node_modules/

# Bun
.bun-debug/

# Test output
coverage/
.nyc_output/

# IDE / editor
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo
.DS_Store

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ra11y local artifacts
.ra11y-baseline.json
.ra11y-manual.json

# .claude runtime state (keep the config, ignore logs)
.claude/history.jsonl
.claude/test-status.json
.claude/env
.claude/scheduled_tasks.lock
.claude/turn-history.jsonl
# Agent-isolation worktrees (real git worktrees under .git/worktrees/;
# their checkouts sit here so dispatched agents can work in parallel
# without disturbing the main tree). Main-tree tooling must not descend
# into them — biome/tsc/bun-test all honor this ignore via their
# respective vcs-ignore hooks.
.claude/worktrees/

# OS junk
Thumbs.db
ehthumbs.db
