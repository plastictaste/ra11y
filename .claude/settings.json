{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.ts\"",
            "timeout": 15
          }
        ]
      }
    ],
    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/instructions-loaded.ts\"",
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/user-prompt-submit.ts\"",
            "async": true,
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git push --force*)",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-tool-use.ts\"",
            "timeout": 5
          },
          {
            "type": "command",
            "if": "Bash(git reset --hard*)",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-tool-use.ts\"",
            "timeout": 5
          },
          {
            "type": "command",
            "if": "Bash(rm -rf *src*)",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-tool-use.ts\"",
            "timeout": 5
          },
          {
            "type": "command",
            "if": "Bash(rm -rf *.claude*)",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-tool-use.ts\"",
            "timeout": 5
          },
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-commit.ts\"",
            "timeout": 180
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(package.json)",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-tool-use.ts\"",
            "timeout": 5
          },
          {
            "type": "command",
            "if": "Edit(.claude/settings.json)",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-tool-use.ts\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-edit.ts\"",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-tool-failure.ts\"",
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/subagent-stop.ts\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop.ts\"",
            "timeout": 120
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/notification.ts\"",
            "async": true
          }
        ]
      }
    ]
  }
}
